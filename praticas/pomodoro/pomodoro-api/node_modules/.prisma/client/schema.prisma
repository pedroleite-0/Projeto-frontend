generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tabela de Usuários (Nova!)
model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String   // Aqui vai o hash, nunca a senha pura
  resetToken String?  // Token temporário para recuperar senha
  createdAt  DateTime @default(now())

  // Relacionamentos: um usuário tem várias tarefas e configurações
  tasks      Task[]
  settings   Setting? 
}

// Tabela de Tarefas (Protegida)
model Task {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  // Chave estrangeira ligando ao Usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

// Tabela de Configurações do Pomodoro (Protegida)
model Setting {
  id         String   @id @default(uuid())
  focusTime  Int      @default(25)
  shortBreak Int      @default(5)
  longBreak  Int      @default(15)

  // Chave estrangeira ligando ao Usuário
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
}